{
  "manifest_version": 3,
  "name": "ReFrame",
  "version": "0.2.0",
  "description": "Rebuilds confusing websites around what you want to do.",
  "action": {
    "default_title": "ReFrame"
  },
  "background": {
    "service_worker": "service_worker.js",
    "type": "module"
  },
  "commands": {
    "toggle-chat": {
      "suggested_key": { "default": "Alt+Shift+R" },
      "description": "Open or close the ReFrame chat"
    }
  },
  "permissions": ["storage", "tabs", "scripting", "activeTab", "contextMenus"],
  "host_permissions": ["<all_urls>"],
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content/snapshot.js", "content/apply.js", "content/widget.js", "content/main.js"],
      "run_at": "document_idle"
    }
  ]
}
