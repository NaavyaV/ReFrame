# LLM
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# Optional: model for automatic rebuilds after navigation (defaults to GROQ_MODEL)
GROQ_FAST_MODEL=
# Groq account limits the server stays under (defaults: free tier, llama-3.3-70b-versatile)
GROQ_RPM=30
GROQ_TPM=12000
GROQ_RPD=1000
GROQ_TPD=100000
# How long a request may queue for Groq budget before getting a 429
GROQ_MAX_WAIT_SECONDS=8
# Per-user limits on model-backed /reframe calls, and per-IP limit on login/register
USER_REFRAME_PER_MINUTE=6
USER_REFRAME_PER_HOUR=60
AUTH_PER_MINUTE=10

# Voice
CARTESIA_API_KEY=
CARTESIA_VOICE_ID=
STT_PROVIDER=cartesia

# Agentverse / ASI
AGENTVERSE_API_KEY=

# SpacetimeDB
SPACETIME_HOST=https://maincloud.spacetimedb.com
SPACETIME_DB_NAME=reframe
SPACETIME_TOKEN=

# Optional public-site extraction
APIFY_API_TOKEN=

# Stripe test-mode secret key (sk_test_...) for bill payment links
STRIPE_SECRET_KEY=

# Generated locally
JWT_SECRET=
BRIDGE_SHARED_SECRET=
ORCHESTRATOR_SEED=
WEBSITE_AGENT_SEED=
CAREGIVER_SEED=

TECHNICAL_HELPER_SEED=
SCRAPER_SEED=
